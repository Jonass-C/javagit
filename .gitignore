# Ignorar pastas de build e dist
/build/
/dist/
/nbbuild/
/nbdist/
/out/
/target/

# Ignorar pasta NetBeans completa
/nbproject/

# Ignorar arquivos privados do NetBeans
/nbproject/private/

# Ignorar arquivos compilados e logs
/**/*.class
/**/*.log
/**/*.ctxt
/**/.mtj.tmp/

/**/*.iml
/**/.idea/
/**/*.prefs

# Ignorar arquivos XML, JARs e pacotes Java
/**/*.xml
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Ignorar arquivos específicos de build
/build.xml
/manifest.mf

# Logs de crash da JVM
hs_err_pid*
replay_pid*

# NetBeans específicos
**/nbproject/Makefile-*.mk
**/nbproject/Package-*.bash
.nb-gradle/